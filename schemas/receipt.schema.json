{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ACDF Task Receipt Schema",
  "type": "object",
  "properties": {
    "taskId": {
      "type": "string",
      "pattern": "^task-[0-9]+$"
    },
    "agentId": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": ["PASS", "FAIL"]
    },
    "planned_change": {
      "type": "string"
    },
    "actual_change": {
      "type": "string"
    },
    "verification_command": {
      "type": "string"
    },
    "evidence_file": {
      "type": "string"
    },
    "prevention": {
      "type": "string"
    },
    "risk_profile_applied": {
      "type": "string"
    }
  },
  "required": [
    "taskId",
    "agentId",
    "timestamp",
    "status",
    "planned_change",
    "actual_change",
    "verification_command",
    "evidence_file",
    "prevention"
  ]
}
