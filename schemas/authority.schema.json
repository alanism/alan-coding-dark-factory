{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ACDF Authority Snapshot Schema",
  "type": "object",
  "properties": {
    "changeName": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "snapshots": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "write_rules": {
      "type": "object",
      "properties": {
        "allowed_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "forbidden_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["allowed_files", "forbidden_files"]
    },
    "graph_checksum": {
      "type": "string"
    },
    "approval": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["human", "council"]
        },
        "decision": {
          "type": "string",
          "enum": ["APPROVED", "BLOCKED"]
        },
        "recorded_by": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        },
        "votes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "voter": {"type": "string"},
              "decision": {"type": "string", "enum": ["APPROVE", "REJECT", "ABSTAIN"]},
              "rationale": {"type": "string"}
            },
            "required": ["voter", "decision", "rationale"]
          }
        },
        "quorum": {
          "type": "integer",
          "minimum": 0
        },
        "approval_count": {
          "type": "integer",
          "minimum": 0
        },
        "hard_stop": {
          "type": "boolean"
        },
        "rationale": {
          "type": "string"
        }
      },
      "required": ["mode", "decision", "recorded_by", "votes", "quorum", "approval_count", "hard_stop", "rationale"]
    }
  },
  "required": ["changeName", "timestamp", "snapshots", "write_rules", "graph_checksum", "approval"]
}
